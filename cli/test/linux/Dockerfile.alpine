# Test runtime only; retains the production Alpine coreutils/Bash tool choices.
FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1
RUN apk add --no-cache bash ca-certificates coreutils curl git git-daemon jq openssl perl procps python3 unzip zip
RUN npm install -g --ignore-scripts --no-audit --no-fund ts-node@10.9.2 typescript@5.2.2 \
    && npm cache clean --force
ENV NODE_PATH=/usr/local/lib/node_modules
WORKDIR /workspace
CMD ["sh", "-c", "node cli/scripts/test.cjs && node cli/scripts/verify-package.cjs"]
