# Internal integration fixture only; not a separately published CLI image.
ARG PANEL_IMAGE=whyour/qinglong:2.20.1@sha256:4e96d821494cfbeddd29f5a46dfb006a5a64f5639e0b8665816fcf55f39a85ea
FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS cli-artifact
WORKDIR /opt/qinglong-cli
COPY cli/dist/ ./dist/
COPY cli/package.json cli/README.md cli/README.en.md ./
COPY cli/docs/ ./docs/
COPY cli/skills/ ./skills/
# Keep interpreter lookup portable across Alpine and Debian panel images.
RUN node -e 'const fs=require("node:fs");fs.mkdirSync("bin");const bins={...require("./package.json").bin,ql:"dist/ql.js",task:"dist/task.js",qinglong:"dist/startup.js"};for(const [name,target] of Object.entries(bins)){if(!fs.readFileSync(target,"utf8").startsWith("#!/usr/bin/env node"))throw Error("Invalid CLI entry");fs.chmodSync(target,0o755);fs.symlinkSync("../"+target,"bin/"+name);}'

FROM ${PANEL_IMAGE}
COPY --from=cli-artifact /opt/qinglong-cli/ /opt/qinglong-cli/
COPY cli/docker/build/deps.js /ql/static/build/loaders/deps.js
ENV QL_CLI_ROOT=/opt/qinglong-cli
ENV PATH=/opt/qinglong-cli/bin:${PATH}
# Refuse accidental application to the independent 3.x work.
RUN node -e 'const version=require("/ql/package.json").version||require("node:fs").readFileSync("/ql/version.yaml","utf8").match(/^version:\s*(\S+)/m)?.[1];if(!/^2\./.test(version||""))throw Error("This CLI overlay requires a QingLong 2.x panel");'

# The CLI runtime is separate from task interpreters; verify the selected panel runtime.
RUN node -e 'const [major,minor]=process.versions.node.split(".").map(Number);if(major<22||(major===22&&minor<12))throw Error("CLI requires Node >=22.12.0");'
