      "default": "./dist/legacy-adoption/localSqliteAdoption.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "require": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./adopted-profile": {
